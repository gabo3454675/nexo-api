# Copia a .env y ajusta credenciales. Crea la base antes: CREATE DATABASE nexo;
# Si tu Windows tiene DATABASE_URL en variables de entorno, el proyecto usa .env con prioridad (override) vía prisma.config.ts y main.ts.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/nexo?schema=public"

CORS_ORIGIN="http://localhost:3001"
JWT_SECRET="cambiar-en-produccion"
KYC_WEBHOOK_SECRET="local-dev"
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
